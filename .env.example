# Database
MONGODB_URI=mongodb://localhost:27017/servora

# Auth (iron-session secret - minimum 32 characters)
SESSION_PASSWORD=servora-super-secret-iron-session-key-32chars-min

# App Base URL (use LAN IP e.g. http://192.168.1.X:3000 when testing from mobile)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# File Upload Directory
UPLOAD_DIR=./public/uploads
